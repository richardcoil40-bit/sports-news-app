{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "worker",
      "runtimeExecutable": "./worker/node_modules/.bin/wrangler",
      "runtimeArgs": [
        "dev",
        "--port",
        "8787",
        "--cwd",
        "worker"
      ],
      "port": 8787
    }
  ]
}
