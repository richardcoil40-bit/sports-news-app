# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts is deliberately NOT ignored, despite the note inside it.
# It is generated, but it is also the only thing declaring expo's ambient
# module types — CSS imports especially. Ignored, `tsc --noEmit` passes on
# any machine that has run the dev server and fails on a fresh clone, which
# is exactly what CI is. Tracking it makes the typecheck reproducible; it
# regenerates to identical content, so it doesn't churn.

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env overrides. Note that `.env` itself is deliberately NOT ignored:
# it carries the public verdicts URL and is meant to be shared. Anything
# that shouldn't be committed belongs in `.env.local`, which Expo loads
# ahead of `.env` — see the header comment in `.env` for the full rule.
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local agent settings
.claude/settings.local.json

# Stray feed-checker output at the repo root. Reports under docs/evidence/
# are deliberately tracked — they're the record of when each source was last
# verified alive. Root-only pattern so scripts/check-feeds.sh output lands in
# version control where it's useful.
/feed-status*.txt
